# Kopieren nach ".env" und anpassen, dann:
#   docker compose build
#   docker compose run --rm finetune ./train.sh

# Dataset-Wurzel mit train_swift.jsonl und den Bildern (siehe convert_dataset.py).
# Wird read-only nach /data gemountet.
DATASET_ROOT=C:/Handschrift-Dataset

# Host-Ordner fuer Checkpoints (wird nach /output gemountet). Relativ zu
# diesem Ordner (finetune/) oder absolut.
OUTPUT_DIR=./output

# Optional: train.sh-Parameter ueberschreiben.
# FT_MODEL=Qwen/Qwen3-VL-4B-Instruct
# FT_DATASET=/data/train_swift.jsonl
# FT_OUTPUT_DIR_CONTAINER=/output/qwen3-vl-4b-handschrift
# FT_EPOCHS=3
